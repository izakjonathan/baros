# Runtime database. Production Bar Ops is database-backed; there is no CONTENT_SOURCE switch.
DATABASE_URL=
DATABASE_DIRECT_URL=

# Canonical public application URL, required in production for invitation links.
APP_URL=http://localhost:3000

# Session configuration.
SESSION_COOKIE_NAME=bar_ops_session
SESSION_TTL_DAYS=30

# Seed-only credentials. Used only by scripts/seed.mjs when ALLOW_DATABASE_SEED is explicitly supplied.
SEED_OWNER_EMAIL=owner@barops.local
SEED_OWNER_PASSWORD=replace-with-a-long-unique-password

# Explicit database-free development mode. This is development-only and is rejected in NODE_ENV=production.
# It is not a production fallback and does not replace PostgreSQL-backed production data.
DEV_AUTH_ENABLED=false
DEV_AUTH_EMAIL=dev@barops.local
DEV_AUTH_PASSWORD=replace-with-at-least-12-characters
DEV_AUTH_SECRET=replace-with-at-least-32-random-characters

# One-time database seed safety switch. Do not store this in Vercel.
# ALLOW_DATABASE_SEED=SEED BAROS
