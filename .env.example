DATABASE_URL=
DATABASE_DIRECT_URL=
APP_URL=http://localhost:3000
SESSION_COOKIE_NAME=bar_ops_session
SESSION_TTL_DAYS=30
SEED_OWNER_EMAIL=owner@barops.local
SEED_OWNER_PASSWORD=replace-with-a-long-unique-password

# Database-free development is opt-in and is rejected in NODE_ENV=production.
DEV_AUTH_ENABLED=false
DEV_AUTH_EMAIL=dev@barops.local
DEV_AUTH_PASSWORD=replace-with-at-least-12-characters
DEV_AUTH_SECRET=replace-with-at-least-32-random-characters

# One-time database seed safety switch. Do not store this in Vercel.
# ALLOW_DATABASE_SEED=SEED BAROS
