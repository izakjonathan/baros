# Set DEV_AUTH_ENABLED=false to force database authentication.
DEV_AUTH_ENABLED=
DEV_AUTH_EMAIL=dev@barops.local
DEV_AUTH_PASSWORD=dev
DEV_AUTH_NAME=Development Manager
DEV_AUTH_SECRET=replace-with-a-long-random-preview-secret

